{
  "name": "playwright-saucedemo-e2e",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:fast": "playwright test --grep-invert @slow",
    "test:allure": "playwright test tests/allure-metadata.spec.ts",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:serve": "allure serve allure-results",
    "test:qa": "cross-env ENV=qa playwright test tests/environment-config.spec.ts",
    "test:staging": "cross-env ENV=staging playwright test tests/environment-config.spec.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.3.0",
    "@types/sql.js": "^1.4.11",
    "allure-commandline": "^2.43.0",
    "allure-playwright": "^3.11.0",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "sql.js": "^1.14.2"
  }
}
